# The settings the API reads (apps/api), with local throwaway values. Real values live only in
# each platform's secret store (roadmap §7, SEC-01). .env files are ignored by git and never
# reach the image (.dockerignore).

# The API: the port it listens on (3000 when unset), and the commit /health reports, which the
# image build sets.
PORT=3000
GIT_COMMIT=

# migrate: the migration role's connection, never the application's (ADR 0080). TLS follows
# the URL's sslmode.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app?sslmode=disable
